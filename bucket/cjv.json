{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/refs/heads/master/schema.json",
    "version": "0.2.10",
    "description": "The Cangjie SDK installer",
    "homepage": "https://cjv.zxilly.dev/",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Zxilly/cjv/releases/download/v0.2.10/cjv_windows_amd64.zip",
            "hash": "0c7f5ff1e0671be54a969fdfd928410d7b5171cde98f1027f34d1ac80fdf23e0"
        }
    },
    "bin": "cjv.exe",
    "pre_install": "if (!(Test-Path \"$persist_dir/settings.toml\")) { New-Item \"$dir/settings.toml\" -ItemType File -Force | Out-Null }",
    "env_set": {
        "CJV_HOME": "$dir"
    },
    "env_add_path": "bin",
    "persist": [
        "bin",
        "toolchains",
        "settings.toml"
    ],
    "checkver": {
        "github": "https://github.com/Zxilly/cjv"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Zxilly/cjv/releases/download/v$version/cjv_windows_amd64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/checksums.txt"
        }
    }
}
